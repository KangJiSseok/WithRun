{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  // OpenAI + Gemini only.
  // Assumes the standard Google provider IDs from the configuration reference.
  // If you're using opencode-antigravity-auth, replace:
  //   google/gemini-3.1-pro-preview -> google/antigravity-gemini-3-pro

  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "ultrawork": {
        "model": "openai/gpt-5.4",
        "variant": "xhigh"
      }
    },

    "hephaestus": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh",
      "textVerbosity": "high",
    },

    "prometheus": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh",
      "textVerbosity": "high",
      "prompt_append": "Use ultrabrain, deep, and writing categories aggressively when delegating. Prefer explicit acceptance criteria, concrete file references, and parallel delegation where safe."
    },

    "metis": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh",
      "textVerbosity": "high",
    },

    "momus": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh",
      "textVerbosity": "high",
    },

    "atlas": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
    },

    "oracle": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh",
      "textVerbosity": "high",
    },

    "explore": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
    },

    "librarian": {
      "model": "google/gemini-3.1-pro-preview",
      "variant": "high",
      "textVerbosity": "medium",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4",
          "reasoningEffort": "high"
        }
      ]
    },

    "multimodal-looker": {
      "model": "google/gemini-3.1-pro-preview",
      "variant": "high",
      "textVerbosity": "medium",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4",
          "reasoningEffort": "high"
        }
      ]
    }
  },

  "categories": {
    "visual-engineering": {
      "model": "google/gemini-3.1-pro-preview",
      "variant": "high",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4",
          "reasoningEffort": "high"
        }
      ]
    },

    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh",
      "textVerbosity": "high",
    },

    "deep": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
    },

    "artistry": {
      "model": "google/gemini-3.1-pro-preview",
      "variant": "high",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4",
          "reasoningEffort": "high"
        }
      ]
    },

    "quick": {
      "model": "openai/gpt-5.4-mini"
    },

    "unspecified-low": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
    },

    "unspecified-high": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh",
      "textVerbosity": "high",
    },

    "writing": {
      "model": "google/gemini-3.1-pro-preview",
      "variant": "high",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4",
          "reasoningEffort": "high"
        }
      ]
    }
  },

  "background_task": {
    "defaultConcurrency": 8,
    "staleTimeoutMs": 240000,
    "providerConcurrency": {
      "openai": 8,
      "google": 8
    },
    "modelConcurrency": {
      "openai/gpt-5.4": 6,
      "google/gemini-3.1-pro-preview": 6
    }
  },

  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [400, 429, 503, 529],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 45,
    "timeout_seconds": 45,
    "notify_on_fallback": true
  },

  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },

  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true,
    "git_env_prefix": "GIT_MASTER=1"
  },

  "tmux": {
    "enabled": false,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}
