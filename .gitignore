# ============================================
# Root .gitignore - Global patterns
# ============================================

# --------------------------------------------
# Dependencies
# --------------------------------------------
node_modules/
.npm/
.yarn/
.pnpm-store/
pnpm-lock.yaml
package-lock.json
yarn.lock

# --------------------------------------------
# Build outputs
# --------------------------------------------
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# --------------------------------------------
# Gradle (Android/Kotlin)
# --------------------------------------------
.gradle/
local.properties
*.hprof

# --------------------------------------------
# IDE / Editor
# --------------------------------------------
.idea/
.vscode/
*.iml
*.iws
*.ipr

# AI / Tooling
.opencode/*
!.opencode/agents/
!.opencode/agents/**
!.opencode/commands/
!.opencode/commands/**
!.opencode/modes/
!.opencode/modes/**
!.opencode/plugins/
!.opencode/plugins/**
!.opencode/skills/
!.opencode/skills/**
!.opencode/themes/
!.opencode/themes/**
!.opencode/tools/
!.opencode/tools/**
!.opencode/oh-my-openagent.jsonc
.opencode/node_modules/
.opencode/**/node_modules/
.sisyphus/
.claude/
_research/

# --------------------------------------------
# OS files
# --------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------------------
# Logs
# --------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------------------------
# Environment / Secrets
# --------------------------------------------
.env
.env.*
.env*.local
*.env
!infra/local/valhalla/.env.example

# Credentials
*.pem
*.key
*.jks
*.p8
*.p12
*.keystore
*.mobileprovision
credentials.json
secrets.*
google-services.json
GoogleService-Info.plist

# --------------------------------------------
# Mobile / Native
# --------------------------------------------
# Expo
.expo/
expo-env.d.ts
.metro-health-check*
web-build/

# iOS / Xcode
*.ipa
*.xcarchive
xcuserdata/
DerivedData/
Pods/
*.jsbundle

# Android
*.apk
*.aab
.cxx/

# --------------------------------------------
# Misc
# --------------------------------------------
*.local
*.orig.*
*~
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.vercel
